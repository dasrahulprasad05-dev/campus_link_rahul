# Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=campusgrid_secure_enterprise_secret_key_2026_dev

# Database (PostgreSQL - Local or Neon.tech / Render free tier)
# DATABASE_URL=postgresql://campusgrid_user:secret@localhost:5432/campusgrid_db
# Or Neon Serverless: postgres://user:pass@ep-xyz.neon.tech/neondb?sslmode=require

# Python AI Service
AI_SERVICE_URL=http://localhost:8000

# Groq API Key (for LLM features: Interview Coach, Question Generator, Roadmap, Policy Q&A)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# WhatsApp Chatbot (Meta Cloud API — free tier)
# 1. Create app at https://developers.facebook.com → Add WhatsApp product
# 2. Get your Phone Number ID and Permanent Access Token
# 3. Set webhook URL to: https://your-domain/api/v1/whatsapp/webhook
WHATSAPP_TOKEN=your_meta_whatsapp_permanent_token
WHATSAPP_PHONE_ID=your_meta_phone_number_id
WHATSAPP_VERIFY_TOKEN=campusgrid_verify_2026
