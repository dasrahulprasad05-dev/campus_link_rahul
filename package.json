{
  "name": "campusgrid",
  "version": "2.0.0",
  "private": true,
  "description": "CAMPUSGRID 2.0 — AI-Powered Campus-to-Corporate Placement Management Platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "cd apps/web && npm install --include=dev && npm run build",
    "dev:web": "npm --prefix apps/web run dev",
    "start:web": "npm --prefix apps/web start",
    "build:web": "cd apps/web && npm install --include=dev && npm run build",
    "dev": "npm --prefix apps/api run dev",
    "start": "npm --prefix apps/api start",
    "test": "npm --prefix apps/api test",
    "migrate": "npm --prefix apps/api run migrate",
    "install:api": "npm --prefix apps/api install",
    "setup": "npm --prefix apps/api install",
    "postinstall": "npm --prefix apps/api install",
    "ai-service": "cd apps/ai-service && uvicorn main:app --reload --port 8000"
  },
  "keywords": ["placement", "campus-recruitment", "ai", "placement-intelligence", "career-automation"],
  "author": "CAMPUSGRID Team",
  "license": "MIT"
}
